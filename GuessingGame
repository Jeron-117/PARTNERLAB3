public class GuessingGame {
    public static String JeronMontecillo(String returnOrExit) {
        String response;

        do {
            int randomNumber = (int)(Math.random() * 67);
            System.out.println("Enter a number between 0 and 67");
            int guess = Integer.parseInt(in.nextLine());

            for (int i = 0; i < 4; i++) {
                if (guess == randomNumber) {
                    i = 67;
                    System.out.println("HOLY MACKEREL! You're dead on it!");
                } else if (guess != randomNumber) {
                    System.out.println("You have " + (4 - i) + " tries remaining.");

                    if (guess > randomNumber) {
                    System.out.println("No. Try lower!");
                    guess = Integer.parseInt(in.nextLine());
                    }
                    if (guess < randomNumber) {
                        System.out.println("No. Try higher!");
                        guess = Integer.parseInt(in.nextLine());
                    }
                }
            }

            System.out.println("Do you wish to play again?");
            response = in.nextLine();
        }
        while (response.equalsIgnoreCase("yes"));

        if (!response.equalsIgnoreCase("yes")) {
            System.out.println("RETURN TO MAIN MENU");
            System.out.println("EXIT RANDOM NUMBER GAMES");
            String returnOrExit = in.nextLine();
            
            if (returnOrExit.equalsIgnoreCase("return")) {
                return;
            }
            else if (returnOrExit.equalsIgnoreCase("exit")) {
                System.out.println("Sayonara sucka!");
            }
        }
    }
}